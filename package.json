{
  "name": "@adobe/aem-block-collection",
  "private": true,
  "version": "1.0.0",
  "description": "Block collection for AEM",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint 'blocks/**/*.css' 'styles/**/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "build:json": "npm-run-all -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"ue/models/component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"ue/models/component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"ue/models/component-filters.json\" -o \"component-filters.json\"",
    "prepare": "husky",
    "update:formula": "rollup -c rollup/jsonformula.rollup.config.js",
    "update:core": "rollup -c rollup/af-core.rollup.config.js",
    "update:formatters": "rollup -c rollup/af-formatters.rollup.config.js",
    "update:functions": "node --eval \"require('fs').copyFileSync('node_modules/@aemforms/af-custom-functions/src/index.js','blocks/form/rules/functions.js')\"",
    "update": "npm run update:core && npm run update:formula && npm run update:formatters",
    "update:mappings": "node --experimental-default-type=module tools/update-mappings.js",
    "create:custom-component": "node --experimental-default-type=module tools/forms-scaffolder.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-block-collection.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-block-collection/issues"
  },
  "homepage": "https://github.com/adobe/aem-block-collection#readme",
  "devDependencies": {
    "@adobe/json-formula": "0.1.50",
    "@aemforms/af-core": "0.22.167",
    "@aemforms/af-custom-functions": "1.0.14",
    "@aemforms/af-formatters": "0.22.167",
    "@babel/eslint-parser": "7.29.7",
    "enquirer": "2.4.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "fs-extra": "11.2.0",
    "husky": "^9.1.7",
    "merge-json-cli": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "rollup": "^2.79.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.0.1",
    "rollup-plugin-terser": "^7.0.2",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0"
  }
}
