  ],
  "models": [
    {
      "id": "wgc-meetings-intro",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "content",
          "value": "",
          "label": "Content",
          "description": "Heading and intro copy. Italicise the opening words of the heading to render them as the lighter lead line. A phone number linked as tel: stays inline as a contact detail rather than becoming a button."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "cta",
          "label": "Call To Action Link",
          "description": "Where the closing button goes, such as the request for proposal form."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaText",
          "label": "Call To Action Text",
          "multi": false
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "classes",
          "label": "Options",
          "options": [
            { "name": "Paper background", "value": "paper" },
            { "name": "Narrow", "value": "narrow" },
            { "name": "No rule under heading", "value": "no-rule" }
          ]
        }
      ]
    }
  ],
  "filters": []
