{
  "definitions": [
    {
      "title": "WGC Meetings Hero",
      "id": "wgc-meetings-hero",
      "model": "wgc-meetings-hero",
      "plugins": {
        "da": {
          "rows": 2,
          "columns": 1,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>div>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>div>picture>img[alt]" },
            { "name": "video", "selector": "div:nth-child(1)>div>p>a[href]" },
            { "name": "content", "selector": "div:nth-child(2)>div" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "wgc-meetings-hero",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image",
          "description": "Still image behind the page heading. Also used as the video poster.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Background Image Alt",
          "multi": false
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "video",
          "label": "Background Video (optional)",
          "description": "Link to an .mp4 or .webm. Fades in over the image once it can play."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "content",
          "value": "",
          "label": "Content",
          "description": "An optional short label such as Plan An Event on its own line, then the page heading. Italicise the opening words of the heading to render them as the lighter lead line."
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "classes",
          "label": "Options",
          "options": [
            { "name": "Short", "value": "short" },
            { "name": "Align left", "value": "left" },
            { "name": "Light overlay", "value": "light" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
