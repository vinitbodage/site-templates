{
  "definitions": [
    {
      "title": "Photo Gallery",
      "id": "photo-gallery",
      "model": "photo-gallery",
      "filter": "photo-gallery",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Photo Gallery Filter",
      "id": "photo-gallery-filter",
      "model": "photo-gallery-filter",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "label", "selector": "div:nth-child(1)" }
          ]
        }
      }
    },
    {
      "title": "Photo Gallery Video",
      "id": "photo-gallery-video",
      "model": "photo-gallery-video",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "video", "selector": "div:nth-child(2)>p>a[href]" },
            { "name": "category", "selector": "div:nth-child(2)>p:nth-child(2)" }
          ]
        }
      }
    },
    {
      "title": "Photo Gallery Image",
      "id": "photo-gallery-image",
      "model": "photo-gallery-image",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "fullImage", "selector": "div:nth-child(2)>p>a[href]" },
            { "name": "category", "selector": "div:nth-child(2)>p:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "photo-gallery",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "pageTitle",
          "label": "Page Title",
          "description": "Visually hidden heading. Live page uses: Pictures Of Clearwater Florida | Photo Gallery | Wyndham Grand."
        }
      ]
    },
    {
      "id": "photo-gallery-filter",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Filter Label",
          "description": "Category name shown in the filter panel."
        }
      ]
    },
    {
      "id": "photo-gallery-video",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Video Thumbnail",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Thumbnail Alt",
          "multi": false
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "video",
          "label": "Video URL",
          "description": "Link to an .mp4 or .webm file."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "category",
          "label": "Category",
          "description": "Optional filter category for the editor only — not shown on the page."
        }
      ]
    },
    {
      "id": "photo-gallery-image",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "fullImage",
          "label": "Full-size Image",
          "description": "Optional link to the full-resolution image for the lightbox."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "category",
          "label": "Category",
          "description": "Optional filter category for the editor only — not shown on the page."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "photo-gallery",
      "components": [
        "photo-gallery-filter",
        "photo-gallery-video",
        "photo-gallery-image"
      ]
    }
  ]
}
