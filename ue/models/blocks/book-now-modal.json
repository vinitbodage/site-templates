          "name": "checkOutLabel",
          "label": "Check-out Label"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "adultsLabel",
          "label": "Adults Label"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "kidsLabel",
          "label": "Kids Label"
        },
        {
          "component": "text",
          "valueType": "string",
