{
  "definitions": [
    {
      "title": "WGC Room",
      "id": "wgc-room",
      "model": "wgc-room",
      "filter": "wgc-room",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "WGC Room Slide",
      "id": "wgc-room-slide",
      "model": "wgc-room-slide",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" }
          ]
        }
      }
    },
    {
      "title": "WGC Room Copy",
      "id": "wgc-room-copy",
      "model": "wgc-room-copy",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "content", "selector": "div:nth-child(1)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "wgc-room",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Image Position",
          "value": "",
          "options": [
            { "name": "Image left", "value": "" },
            { "name": "Image right", "value": "image-right" }
          ]
        }
      ]
    },
    {
      "id": "wgc-room-slide",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        }
      ]
    },
    {
      "id": "wgc-room-copy",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "content",
          "value": "",
          "label": "Content",
          "description": "Room name, description, and an optional Book Now call to action. Put copy in the left column and images in the right column to flip the layout, or use the block Image Position option."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "wgc-room",
      "components": [
        "wgc-room-slide",
        "wgc-room-copy"
      ]
    }
  ]
}
