{
  "definitions": [
    {
      "title": "WGC Accordion",
      "id": "wgc-accordion",
      "model": "wgc-accordion",
      "filter": "wgc-accordion",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 3
        }
      }
    },
    {
      "title": "WGC Accordion Heading",
      "id": "wgc-accordion-heading",
      "model": "wgc-accordion-heading",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "eyebrow", "selector": "div:nth-child(1)" },
            { "name": "heading", "selector": "div:nth-child(2)" }
          ]
        }
      }
    },
    {
      "title": "WGC Accordion Item",
      "id": "wgc-accordion-item",
      "model": "wgc-accordion-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 3,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "title", "selector": "div:nth-child(2)" },
            { "name": "body", "selector": "div:nth-child(3)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "wgc-accordion",
      "fields": []
    },
    {
      "id": "wgc-accordion-heading",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "eyebrow",
          "label": "Eyebrow",
          "description": "Small line above the heading, e.g. Spa Services. CSS displays it in uppercase."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "description": "Main heading, e.g. At Pallavi Luxury Spa. CSS displays it in uppercase.",
          "required": true
        }
      ]
    },
    {
      "id": "wgc-accordion-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "Label on the teal trigger bar, e.g. How To Spa.",
          "required": true
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "body",
          "value": "",
          "label": "Body",
          "description": "Content shown when this item is open. Use italics for the intro line and headings for sections such as Booking or Cancellations.",
          "required": true
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "wgc-accordion",
      "components": [
        "wgc-accordion-heading",
        "wgc-accordion-item"
      ]
    }
  ]
}
