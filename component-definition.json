            "da": {
              "rows": 4,
              "columns": 2,
              "unsafeHTML": "<div class=\"spotlight-grid cols-3\"><div><div><p><em>Collection</em></p><h2>Heading</h2><p>Optional intro</p></div></div><div><div><picture><img loading=\"lazy\"></picture></div><div><h3>Item</h3><p>Caption</p></div></div><div><div><picture><img loading=\"lazy\"></picture></div><div><h3>Item</h3><p>Caption</p></div></div><div><div><picture><img loading=\"lazy\"></picture><p><a href=\"\">Watch film</a></p></div><div><h3>Video item</h3><p>Caption</p></div></div></div>"
