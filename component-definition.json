{
  "groups": [
    {
      "title": "Default Content",
      "id": "default",
      "components": [
        {
          "title": "Text",
          "id": "text",
          "model": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Image",
          "id": "image",
          "model": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "image",
              "fields": [
                {
                  "name": "image",
                  "selector": "img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "img[alt]"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Sections",
      "id": "sections",
      "components": [
        {
          "title": "Section",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>"
            }
          },
          "filter": "section",
          "model": "section"
        }
      ]
    },
    {
      "title": "Blocks",
      "id": "blocks",
      "components": [
        {
          "title": "Fragment",
          "id": "fragment",
          "model": "fragment",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"fragment\"><div><div><p><a href=\"\">Fragment URL</a></p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "urlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Orbit Hero",
          "id": "orbit-hero",
          "model": "orbit-hero",
          "plugins": {
            "da": {
              "rows": 3,
              "columns": 3,
              "unsafeHTML": "<div class=\"orbit-hero\"><div><div><picture><img loading=\"eager\"></picture></div><div>Suites</div><div><p><em>Stay</em></p><h1>Headline</h1><p>Support</p><p><a href=\"#\">Explore</a></p></div></div><div><div><picture><img loading=\"lazy\"></picture></div><div>Dining</div><div><p><em>Taste</em></p><h2>Headline</h2><p>Support</p><p><a href=\"#\">Explore</a></p></div></div><div><div><picture><img loading=\"lazy\"></picture></div><div>Spa</div><div><p><em>Restore</em></p><h2>Headline</h2><p>Support</p><p><a href=\"#\">Explore</a></p></div></div></div>"
            }
          }
        },
        {
          "title": "Signature Hero",
          "id": "signature-hero",
          "model": "signature-hero",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"signature-hero\"><div><div><picture><img loading=\"eager\"></picture></div></div><div><div><p><strong>Brand</strong></p><h1>Headline</h1><p>Support</p><p><a href=\"#\">Reserve</a></p></div></div></div>"
            }
          }
        },
        {
          "title": "Editorial Split",
          "id": "editorial-split",
          "model": "editorial-split",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "unsafeHTML": "<div class=\"editorial-split\"><div><div><picture><img loading=\"lazy\"></picture></div><div><p><em>Eyebrow</em></p><h2>Heading</h2><p>Copy</p><p><a href=\"#\">Learn more</a></p></div></div></div>"
