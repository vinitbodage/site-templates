        {
          "title": "Premium Membership",
          "id": "premium-membership",
          "model": "premium-membership",
          "plugins": {
            "da": {
              "rows": 5,
              "columns": 1,
              "unsafeHTML": "<div class=\"premium-membership\"><div><div><p><em>Membership</em></p><h2>Solenne Circle</h2><p>Unlock quieter arrivals and considered privileges.</p><p>€180 / year</p></div></div><div><div>Priority suite holds before public release</div></div><div><div>Complimentary courtyard breakfast each morning</div></div><div><div>Late checkout until 2pm when available</div></div><div><div>Private rooftop hour once per stay</div></div></div>"
