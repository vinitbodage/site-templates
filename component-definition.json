          "id": "theme-picker",
          "model": "theme-picker",
          "plugins": {
            "da": {
              "name": "theme-picker",
              "rows": 1,
              "columns": 1
            }
          }
        },
        {
          "title": "Spacer",
          "id": "spacer",
          "model": "spacer",
          "plugins": {
            "da": {
              "rows": 2,
              "columns": 2,
              "unsafeHTML": "<div class=\"spacer\"><div><div>Size</div><div>48</div></div><div><div>Side</div><div>top</div></div></div>"
            }
          }
